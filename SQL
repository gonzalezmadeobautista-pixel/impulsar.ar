-- Impulsar · esquema para Supabase. Ejecutalo completo en: SQL Editor → New query → Run

create table profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  name text not null,
  role text not null default 'Emprendedor' check (role in ('Emprendedor','Inversor','Ambos')),
  is_admin boolean not null default false,
  created_at timestamptz not null default now()
);

create table projects (
  id uuid primary key default gen_random_uuid(),
  owner uuid not null references profiles(id) on delete cascade,
  name text not null check (char_length(name) between 3 and 80),
  description text not null check (char_length(description) between 10 and 200),
  problem text, solution text, use_of_funds text, team text,
  category text not null, province text not null, stage text not null, mode text not null,
  goal numeric not null check (goal > 0),
  raised numeric not null default 0 check (raised >= 0),
  status text not null default 'borrador' check (status in ('borrador','en_revision','publicado','rechazado')),
  reject_reason text,
  reviewed_at timestamptz,
  created_at timestamptz not null default now()
);

create table favorites (
  user_id uuid not null references profiles(id) on delete cascade,
  project_id uuid not null references projects(id) on delete cascade,
  primary key (user_id, project_id)
);

create table messages (
  id uuid primary key default gen_random_uuid(),
  project_id uuid not null references projects(id) on delete cascade,
  from_user uuid not null references profiles(id) on delete cascade,
  to_user uuid not null references profiles(id) on delete cascade,
  body text not null check (char_length(body) between 1 and 2000),
  created_at timestamptz not null default now()
);

-- Función auxiliar: ¿el usuario actual es administrador?
create or replace function is_admin() returns boolean
language sql security definer stable set search_path = public as $$
  select coalesce((select is_admin from profiles where id = auth.uid()), false)
$$;

-- Al registrarse un usuario se crea su perfil (nunca como administrador)
create or replace function handle_new_user() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  insert into profiles (id, name, role)
  values (
    new.id,
    coalesce(nullif(trim(new.raw_user_meta_data->>'name'), ''), 'Usuario'),
    case when new.raw_user_meta_data->>'role' in ('Emprendedor','Inversor','Ambos')
         then new.raw_user_meta_data->>'role' else 'Emprendedor' end
  );
  return new;
end $$;
create trigger on_auth_user_created after insert on auth.users
  for each row execute function handle_new_user();

-- Seguridad a nivel de fila
alter table profiles  enable row level security;
alter table projects  enable row level security;
alter table favorites enable row level security;
alter table messages  enable row level security;

-- Perfiles: se pueden leer; cada uno edita solo su nombre y rol (nunca is_admin)
create policy "perfiles visibles" on profiles for select to anon, authenticated using (true);
create policy "editar mi perfil" on profiles for update to authenticated using (id = auth.uid()) with check (id = auth.uid());
revoke update on profiles from authenticated;
grant update (name, role) on profiles to authenticated;

-- Proyectos: público solo lo publicado; el dueño ve los suyos; el admin ve todo
create policy "ver proyectos" on projects for select to anon, authenticated
  using (status = 'publicado' or owner = auth.uid() or is_admin());
create policy "crear proyecto" on projects for insert to authenticated
  with check (owner = auth.uid() and status in ('borrador','en_revision') and raised = 0);
create policy "dueño edita" on projects for update to authenticated
  using (owner = auth.uid() and status in ('borrador','en_revision','rechazado'))
  with check (owner = auth.uid() and status in ('borrador','en_revision') and raised = 0);
create policy "admin gestiona" on projects for update to authenticated
  using (is_admin()) with check (is_admin());

-- Favoritos: solo los propios
create policy "mis favoritos" on favorites for all to authenticated
  using (user_id = auth.uid()) with check (user_id = auth.uid());

-- Mensajes: los ve quien envía o recibe; solo se envía como uno mismo
create policy "ver mis mensajes" on messages for select to authenticated
  using (from_user = auth.uid() or to_user = auth.uid());
create policy "enviar mensaje" on messages for insert to authenticated
  with check (from_user = auth.uid() and to_user <> auth.uid());

